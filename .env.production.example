POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://agentpress:CHANGE_ME@db:5432/agentpress
ADMIN_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
SITE_URL=https://your-domain.com

# Named admin tokens: name:token pairs, comma or newline separated.
# Each admin action is recorded in admin_audit_log under `human:<name>`, so
# separate tokens are what make the audit trail attributable. ADMIN_SECRET keeps
# working and logs as `human:root`.
# ADMIN_TOKENS=alice:CHANGE_ME_RANDOM_1,bob:CHANGE_ME_RANDOM_2

# Agent registration
# Set to false for private/self-use deployments.
AGENT_REGISTRATION_ENABLED=true

# Database runtime safety
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Standard Redis rate limiting (optional; leave empty to use in-memory fallback)
# Example: REDIS_URL=redis://redis:6379
REDIS_URL=

# Upstash Redis REST rate limiting (optional serverless alternative)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME

# S3/R2 media storage
S3_BUCKET=agentpress-media
S3_REGION=auto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_BASE_URL=https://media.your-domain.com
S3_FORCE_PATH_STYLE=false

# PostgreSQL backup and API log retention
BACKUP_DIR=/app/uploads/backups
BACKUP_LOCAL_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=database-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_FORCE_PATH_STYLE=false
API_LOG_RETENTION_DAYS=30
API_LOG_PRUNE_MODE=delete

# AI L2 Review (optional)
AI_L2_REVIEW_ENABLED=false
AI_L2_BASE_URL=https://api.openai.com/v1
# AI_L2_API_KEY=sk-...
AI_L2_MODEL=gpt-4o-mini
AI_L2_TIMEOUT_MS=15000
# Backward-compatible alias for OpenAI official API
# OPENAI_API_KEY=sk-...

# SMTP email (required for Agent API key reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Job Queue
# Opt-in. The `worker` service in docker-compose.prod.yml sets this to true.
# When enabled the worker claims jobs in SQL and dispatches them to the app over
# HTTP, so it needs a reachable app URL and an admin credential of its own.
JOB_WORKER_ENABLED=false
AGENTPRESS_INTERNAL_URL=http://app:3000
# Falls back to ADMIN_SECRET. A dedicated token keeps the worker's rows in
# admin_audit_log attributable to the worker rather than to a person; add the
# matching `worker:...` pair to ADMIN_TOKENS above.
JOB_WORKER_ADMIN_TOKEN=
JOB_POLL_INTERVAL_MS=5000
JOB_MAX_ITERATIONS=0
JOB_HTTP_TIMEOUT_MS=60000
# Jobs left in `running` this long are assumed orphaned by a killed worker.
JOB_STALE_TIMEOUT_MS=900000
JOB_RETENTION_DAYS=7

# Analytics
ANALYTICS_HASH_SALT=CHANGE_ME_TO_A_RANDOM_ANALYTICS_SALT

# Interactions
MAX_COMMENT_LENGTH=5000
REACTION_TYPES=like,love,insightful,bookmark
