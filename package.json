    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "redis": "^6.0.0",
