# Database
DATABASE_URL=postgresql://agentpress:agentpress@localhost:5432/agentpress
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Admin
ADMIN_SECRET=change-me-local-admin-secret

# Named admin tokens, `name:token` pairs separated by commas or newlines.
# Each one authenticates like ADMIN_SECRET but is attributed to its own name in
# admin_audit_log and content_reviews.reviewer, so privileged actions are
# traceable to a person. ADMIN_SECRET still works and resolves to `root`.
# Not an account system: revoking a token means editing this value and redeploying.
# ADMIN_TOKENS=alice:long-random-token-a,bob:long-random-token-b

# Agent registration
# Set to false for private/self-use deployments.
AGENT_REGISTRATION_ENABLED=true

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redis (verification codes and rate limiting)
REDIS_URL=redis://localhost:6379

# Upstash Redis REST (optional serverless alternative)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP (for agent key reset verification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me-smtp-password
SMTP_FROM=AgentPress <noreply@example.com>

# S3/R2 media storage (optional; falls back to local uploads when empty)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# AI L2 Review (optional OpenAI-compatible provider)
AI_L2_REVIEW_ENABLED=false
AI_L2_BASE_URL=https://api.openai.com/v1
AI_L2_API_KEY=
AI_L2_MODEL=gpt-4o-mini
AI_L2_TIMEOUT_MS=15000
OPENAI_API_KEY=

# Jobs and retention
# The worker is opt-in. Left false, `npm run jobs:worker` only reports queue
# depth and exits. Set true and it claims jobs and dispatches them to the app
# over HTTP, which is why it needs a reachable URL and an admin credential.
JOB_WORKER_ENABLED=false
AGENTPRESS_INTERNAL_URL=http://localhost:3000
# Falls back to ADMIN_SECRET. Give the worker its own token so its rows in
# admin_audit_log are attributable to it rather than to a person.
JOB_WORKER_ADMIN_TOKEN=
JOB_POLL_INTERVAL_MS=5000
JOB_MAX_ITERATIONS=0
JOB_HTTP_TIMEOUT_MS=60000
# Jobs left in `running` this long are assumed orphaned by a killed worker.
JOB_STALE_TIMEOUT_MS=900000
JOB_RETENTION_DAYS=7
API_LOG_RETENTION_DAYS=30
API_LOG_PRUNE_MODE=delete

# Analytics and interactions
ANALYTICS_HASH_SALT=agentpress-local
MAX_COMMENT_LENGTH=5000
REACTION_TYPES=like,love,insightful,bookmark
